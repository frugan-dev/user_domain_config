{
    "name": "frugan-dev/user_domain_config",
    "description": "Per-User-Domain Configuration Plugin for Roundcube",
    "license": "GPL-3.0-or-later",
    "type": "roundcube-plugin",
    "keywords": [
        "roundcube",
        "roundcube-plugin"
    ],
    "authors": [
        {
            "name": "Frugan",
            "email": "dev@frugan.it",
            "homepage": "https://frugan.it",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/frugan-dev/user_domain_config",
    "support": {
        "issues": "https://github.com/frugan-dev/user_domain_config/issues",
        "source": "https://github.com/frugan-dev/user_domain_config",
        "docs": "https://github.com/frugan-dev/user_domain_config#readme"
    },
    "funding": [
        {
            "type": "custom",
            "url": "https://buymeacoff.ee/frugan"
        }
    ],
    "require": {
        "php": "^7.1 || ^8.0",
        "roundcube/plugin-installer": "~0.3.5"
    },
    "require-dev": {
        "laravel/pint": "^1.0"
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "roundcube/plugin-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "roundcube": {
            "min-version": "1.5.0"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint"
    }
}
